# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging
# NOTE: build/ itself is tracked (it holds legacy Android project stubs),
# so only the Python build products are ignored.
build/lib/
build/bdist.*/
dist/
*.egg-info/
*.egg
wheels/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Generated binary artefacts (build outputs, never sources)
#   *.apk / *.bin / *.यन्त्र / *.img are produced by the builders; keeping them
#   in git is how the repository ended up with text files named ".apk".
*.apk
*.bin
*.यन्त्र
*.img
*.zip
apk_output/
apk_build/
output/
store/apps/*.apk

# Generated demo data
/cpu_output/
*.dex
# Modules emitted by the self-growing AI demos (they now write under BRAHMA_HOME;
# these patterns catch an older run that wrote straight into the checkout).
/स्वायत्त_*.py
/मॉड्यूल_*.py
/कार्य_*.py
/निर्मित_अनुप्रयोग/
/निर्मित_एण्ड्रॉयड/

# Images rendered by `brahma llm image` at the repository root
/brahma-*.png
