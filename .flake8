[flake8]
max-line-length = 127
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    release,
    # The historical prototype tree predates any style guide and is kept
    # for provenance only (see docs/AUDIT.md).  CI lints brahma/, tests/ and
    # tools/ explicitly instead of the whole repository.
