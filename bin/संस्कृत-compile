#!/usr/bin/env python3

import sys
import os

# correct path add करो
sys.path.append(os.path.expanduser("~/सूत्र-तंत्र/compiler"))

from compiler_engine import compile_file

if len(sys.argv) < 2:
    print("Usage: संस्कृत-compile <file.सूत्र>")
    sys.exit(1)

input_file = sys.argv[1]
output_file = input_file.replace(".सूत्र", ".py")

compile_file(input_file, output_file)
