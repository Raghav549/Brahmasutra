# 🕉️ गणित — अंकगणित, चर और वरीयता
स्थापय अ = १०
स्थापय ब = २०

दर्शय "अ = " + पाठ(अ)
दर्शय "ब = " + पाठ(ब)
दर्शय "योग: " + पाठ(अ + ब)
दर्शय "अन्तर: " + पाठ(ब - अ)
दर्शय "गुणन: " + पाठ(अ * ब)
दर्शय "भाग: " + पाठ(ब / अ)
दर्शय "शेष: " + पाठ(ब % अ)
दर्शय "घात: " + पाठ(२ ** १०)

# वरीयता: गुणन पहले
दर्शय 2 + 3 * 4      # 14
दर्शय (2 + 3) * 4    # 20

# चक्रवृद्धि (compound assignment)
अ += ५
दर्शय "अ अब: " + पाठ(अ)
