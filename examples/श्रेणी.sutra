# 🕉️ श्रेणी — सूची (list) और सूचकांक
स्थापय सूची = [1, 2, 3, 4, 5]

दर्शय "सूची: " + पाठ(सूची)
दर्शय "लम्बाई: " + पाठ(लम्बाई(सूची))
दर्शय "पहला: " + पाठ(सूची[0])
दर्शय "अन्तिम: " + पाठ(सूची[-1])

सूची[0] = 100
दर्शय "बदलने के बाद: " + पाठ(सूची)

# योग निकालें
स्थापय योग = 0
स्थापय i = 0
यावत् i < लम्बाई(सूची)
    योग = योग + सूची[i]
    i = i + 1
अन्त

दर्शय "कुल योग: " + पाठ(योग)
दर्शय "सबसे बड़ा: " + पाठ(अधिकतम(सूची))
दर्शय "सबसे छोटा: " + पाठ(न्यूनतम(सूची))
