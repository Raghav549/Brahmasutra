# गणित — BRAHMA मानक पुस्तकालय (सूत्र में लिखा गया)
#
#   आयात "गणित"            # सब नाम वर्तमान कक्ष में आ जाते हैं
#   आयात "गणित" जैसे ग     # सब नाम एक तालिका में

कार्य वर्ग(मान)
    प्रत्यागमन मान * मान
अन्त

कार्य घन(मान)
    प्रत्यागमन मान * मान * मान
अन्त

कार्य घात(आधार, शक्ति)
    स्थापय फल = 1
    स्थापय गिन = 0
    यावत् गिन < शक्ति
        स्थापय फल = फल * आधार
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य सम(मान)
    प्रत्यागमन मान % 2 == 0
अन्त

कार्य विषम(मान)
    प्रत्यागमन मान % 2 != 0
अन्त

कार्य महत्तम(अ, ब)
    यावत् ब != 0
        स्थापय शेष = अ % ब
        स्थापय अ = ब
        स्थापय ब = शेष
    अन्त
    प्रत्यागमन अ
अन्त

कार्य लघुत्तम(अ, ब)
    प्रत्यागमन संख्या(अ * ब / महत्तम(अ, ब))
अन्त

कार्य क्रमगुणित(मान)
    स्थापय फल = 1
    स्थापय गिन = 2
    यावत् गिन <= मान
        स्थापय फल = फल * गिन
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य फिबोनाची(मान)
    स्थापय अ = 0
    स्थापय ब = 1
    स्थापय गिन = 0
    यावत् गिन < मान
        स्थापय अगला = अ + ब
        स्थापय अ = ब
        स्थापय ब = अगला
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन अ
अन्त

कार्य अभाज्य(मान)
    यदि मान < 2
        प्रत्यागमन असत्य
    अन्त
    स्थापय भाजक = 2
    यावत् भाजक * भाजक <= मान
        यदि मान % भाजक == 0
            प्रत्यागमन असत्य
        अन्त
        स्थापय भाजक = भाजक + 1
    अन्त
    प्रत्यागमन सत्य
अन्त

कार्य गुणनखंड(मान)
    स्थापय फल = []
    स्थापय भाजक = 2
    यावत् भाजक * भाजक <= मान
        यावत् मान % भाजक == 0
            जोड़ें(फल, भाजक)
            स्थापय मान = संख्या(मान / भाजक)
        अन्त
        स्थापय भाजक = भाजक + 1
    अन्त
    यदि मान > 1
        जोड़ें(फल, मान)
    अन्त
    प्रत्यागमन फल
अन्त

कार्य औसत(सूची_मान)
    यदि लम्बाई(सूची_मान) == 0
        प्रत्यागमन 0
    अन्त
    प्रत्यागमन योगफल(सूची_मान) / लम्बाई(सूची_मान)
अन्त

कार्य त्रिभुज_क्षेत्रफल(आधार, ऊँचाई)
    प्रत्यागमन आधार * ऊँचाई / 2
अन्त
