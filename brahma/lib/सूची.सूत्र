# सूची — BRAHMA मानक पुस्तकालय: सूची उपयोग

कार्य अनन्य(सूची_मान)
    स्थापय फल = []
    स्थापय गिन = 0
    यावत् गिन < लम्बाई(सूची_मान)
        यदि न समाविष्ट(फल, सूची_मान[गिन])
            जोड़ें(फल, सूची_मान[गिन])
        अन्त
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य खंड(सूची_मान, आकार)
    स्थापय फल = []
    यदि आकार <= 0
        प्रत्यागमन फल
    अन्त
    स्थापय गिन = 0
    यावत् गिन < लम्बाई(सूची_मान)
        जोड़ें(फल, सूची_मान[गिन:गिन + आकार])
        स्थापय गिन = गिन + आकार
    अन्त
    प्रत्यागमन फल
अन्त

कार्य समतल(सूचियाँ)
    स्थापय फल = []
    स्थापय गिन = 0
    यावत् गिन < लम्बाई(सूचियाँ)
        विस्तार(फल, सूचियाँ[गिन])
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य बारंबारता(सूची_मान)
    स्थापय फल = {}
    स्थापय गिन = 0
    यावत् गिन < लम्बाई(सूची_मान)
        स्थापय मान = सूची_मान[गिन]
        यदि समाविष्ट(फल, मान)
            फल[मान] = फल[मान] + 1
        अन्यथा
            फल[मान] = 1
        अन्त
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य उलटी_सूची(सूची_मान)
    स्थापय फल = []
    स्थापय गिन = लम्बाई(सूची_मान) - 1
    यावत् गिन >= 0
        जोड़ें(फल, सूची_मान[गिन])
        स्थापय गिन = गिन - 1
    अन्त
    प्रत्यागमन फल
अन्त
