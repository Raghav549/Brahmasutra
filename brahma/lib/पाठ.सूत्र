# पाठ — BRAHMA मानक पुस्तकालय: शब्द और वाक्य

कार्य शब्दों_में(पाठ_मान)
    स्थापय फल = []
    स्थापय भाग = विभाजन(त्रिम(पाठ_मान), " ")
    स्थापय गिन = 0
    यावत् गिन < लम्बाई(भाग)
        यदि लम्बाई(भाग[गिन]) > 0
            जोड़ें(फल, भाग[गिन])
        अन्त
        स्थापय गिन = गिन + 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य शब्द_संख्या(पाठ_मान)
    प्रत्यागमन लम्बाई(शब्दों_में(पाठ_मान))
अन्त

कार्य पलटो(पाठ_मान)
    स्थापय फल = ""
    स्थापय गिन = लम्बाई(पाठ_मान) - 1
    यावत् गिन >= 0
        स्थापय फल = फल + पाठ_मान[गिन]
        स्थापय गिन = गिन - 1
    अन्त
    प्रत्यागमन फल
अन्त

कार्य बड़ा(पाठ_मान)
    प्रत्यागमन बड़े(पाठ_मान)
अन्त

कार्य छोटा(पाठ_मान)
    प्रत्यागमन छोटे(पाठ_मान)
अन्त

कार्य काटो(पाठ_मान, सीमा)
    यदि लम्बाई(पाठ_मान) <= सीमा
        प्रत्यागमन पाठ_मान
    अन्त
    प्रत्यागमन पाठ_मान[0:सीमा] + "…"
अन्त

कार्य शब्द_जोड़ो(शब्द, जोड़क)
    प्रत्यागमन जोड़ो(जोड़क, शब्द)
अन्त

कार्य गिनो(पाठ_मान, खोजो)
    स्थापय निशान = लम्बाई(खोजो)
    यदि निशान == 0
        प्रत्यागमन 0
    अन्त
    स्थापय गिन = 0
    स्थापय स्थान_मान = 0
    यावत् स्थान_मान + निशान <= लम्बाई(पाठ_मान)
        यदि पाठ_मान[स्थान_मान:स्थान_मान + निशान] == खोजो
            स्थापय गिन = गिन + 1
            स्थापय स्थान_मान = स्थान_मान + निशान
        अन्यथा
            स्थापय स्थान_मान = स्थान_मान + 1
        अन्त
    अन्त
    प्रत्यागमन गिन
अन्त
